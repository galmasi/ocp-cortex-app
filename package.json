{
  "name": "ocp-cortex-plugin",
  "version": "0.1.0",
  "description": "OpenShift console dynamic plugin for Cortex (per-user HAProxy service)",
  "private": true,
  "consolePlugin": {
    "name": "cortex",
    "version": "0.8.3",
    "displayName": "Cortex",
    "description": "Per-user Cortex service control surface",
    "exposedModules": {
      "CortexPage": "./src/CortexPage"
    },
    "dependencies": {
      "@console/pluginAPI": "*"
    }
  },
  "scripts": {
    "clean": "rm -rf cortex-plugin-image/dist",
    "build": "npm run clean && webpack"
  },
  "dependencies": {
    "@openshift-console/dynamic-plugin-sdk": "4.22.0",
    "@patternfly/react-core": "^6.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.22.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "css-loader": "^6.7.1",
    "file-loader": "^6.2.0",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.2.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webpack": "^5.100.0",
    "webpack-cli": "^4.9.2"
  }
